# Copy to .env.local and fill in from Supabase dashboard → Settings → API.
# The publishable key is safe to expose in the browser; RLS is the actual
# security boundary. NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where NEW listing photos/video are uploaded.
#   unset / supabase → Supabase Storage (1 GB free tier)
#   r2               → Cloudflare R2 (10 GB free + free egress)
# Reads always work for both, so old files keep loading either way. Set this to
# `r2` only after the R2 bucket, API token, CORS rules, and the `media` Edge
# Function secrets are all in place. Flipping it back is the rollback.
#
# NOTE: R2 credentials are NOT set here — they live only in the Edge Function's
# secrets on Supabase, so they never reach the browser.
VITE_MEDIA_PROVIDER=supabase

# ---------------------------------------------------------------------------
# Maps. Both are PUBLIC, browser-side keys — their security comes from being
# restricted by domain in each provider's console, NOT from being secret.
# Restrict them before going live or a scraped key can run up your bill.
# Without them the app still works; maps degrade to a placeholder.
# ---------------------------------------------------------------------------

# Mapbox public token (pk.…) — all read-only maps: Map View, listing detail,
# and the cached card thumbnails. 50,000 free map loads/month.
# Restrict by URL in Mapbox → Account → Tokens.
VITE_MAPBOX_TOKEN=

# Google Maps browser key — used ONLY to place a pin when adding a property,
# for its stronger Indian address search. 10,000 free map loads/month.
# In Google Cloud Console: restrict by HTTP referrer AND limit the key to the
# "Maps JavaScript API" + "Places API" only.
VITE_GOOGLE_MAPS_KEY=
